# Copy to .env and fill in. Never commit .env.
APP_NAME=circulariq-api
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Neon → your project → Connect → copy the connection string (pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
# Answers use MODEL_SMART for this many per rolling 24h, then MODEL_FAST.
SMART_ANSWERS_PER_DAY=50

VOYAGE_API_KEY=
EMBED_MODEL=voyage-4
RERANK_MODEL=rerank-3
# Tokens/minute cap for Voyage. Without a payment method on Voyage, set this low (e.g. 10000).
# With a card added (free tokens still apply), leave 0 for no throttle.
VOYAGE_TPM=0
# Requests/minute cap. Without a card set this to 3.
VOYAGE_RPM=0
